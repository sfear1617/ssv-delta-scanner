# ── Telegram Bot (required for alerts) ──────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Target chat ID — your personal ID, a group ID (negative), or a channel ID
# To find your chat ID: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=987654321

# Minimum minutes between two alerts for the same symbol+direction (default 240 = 4h)
TELEGRAM_ALERT_COOLDOWN_MIN=240

# Set to 'false' to disable all Telegram output while keeping the scheduler running
TELEGRAM_ENABLED=true

# ── Scheduler settings ────────────────────────────────────────────────────────
# Timeframe the auto-scheduler watches (fires at each 4h candle close)
SCHEDULER_TIMEFRAME=4h

# Pivot strength (bars each side to confirm a swing high/low)
SCHEDULER_STRENGTH=3

# Max active swing highs/lows tracked per direction
SCHEDULER_MAX_ACTIVE=50

# sweep_candle (wider, default) or original_strict (Pine midpoint filter)
SCHEDULER_SIGNAL_MODE=sweep_candle

# How many recently closed candles to include per scheduled scan (1 = latest only)
SCHEDULER_RECENT=1

# Minimum 24h USD turnover to send an alert (0 = no filter)
SCHEDULER_MIN_TURNOVER_USD=0

# ── Railway / Server ──────────────────────────────────────────────────────────
# Railway injects PORT automatically — no need to set this manually
# PORT=8000
